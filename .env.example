# Database
# PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://user:password@localhost:5432/dare_beauty_db"

# Authentication
# Secret key used for JWT HS256 signing (min 32 chars)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Application
# Public URL of the hosted app (used for OAuth callbacks, self-referential links)
APP_URL="http://localhost:3000"

# Backend server port
PORT=4000
